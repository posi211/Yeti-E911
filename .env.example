# Copy to .env, fill in, then: chmod 600 .env   (never commit or share the real file)

# --- Databases ---------------------------------------------------------------
# This app's own database (customers, numbers, calls, users)
E911_DB_URL=postgres://e911:CHANGE_ME@127.0.0.1:5432/e911
# Your Yeti CDR database. Create a READ-ONLY role for it (SELECT on the cdr table).
CDR_DB_URL=postgres://READONLY_USER:CHANGE_ME@YETI_CDR_HOST:5432/CDR_DATABASE

# --- Yeti admin API (live calls) ---------------------------------------------
YETI_API_URL=http://YETI_HOST:6666
YETI_API_USER=CHANGE_ME
YETI_API_PASS=CHANGE_ME

# --- Web app -----------------------------------------------------------------
PORT=3100
# Long random value that signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# --- Email (SMTP2GO HTTP API) ------------------------------------------------
SMTP2GO_API_KEY=
# Sender address; must be a sender/domain you have verified in SMTP2GO
MAIL_FROM=alerts@example.com
# Staff addresses that always get the staff copy of every alert (comma separated).
# More can be added in the portal under Numbers & Users.
ADMIN_EMAILS=oncall@example.com
# 1 = also alert staff on test calls (933 etc). 0 = real 911 calls only.
NOTIFY_TEST=0

# --- Optional ----------------------------------------------------------------
# Name shown in the portal, emails and as the sender name
#BRAND_NAME=Yeti-E911
# Time zone used for times in alert emails
#ALERT_TZ=America/New_York
# Charge per 911 call with no ELIN address on file. If set, staff alerts and the
# dashboard banner show the cost. Leave unset to show none.
#NO_ELIN_FEE=100
#LIVE_POLL_MS=2000
#CDR_POLL_MS=60000
